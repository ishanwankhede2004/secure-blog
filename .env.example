# Copy to .env for reference. The app reads real environment variables,
# so set these in your host's dashboard (Render, Railway, Fly, ...).

# Required in production
NODE_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-unique-password   # used only when the database has no users yet

# For hosts whose disk is wiped on restart (Render free tier): when the blog is
# empty at start-up, restore 19 sample posts and an "editor" login.
SEED_DEMO=1
EDITOR_PASSWORD=choose-another-long-password

# Set to 1 when the app runs behind a hosting proxy (Render, Railway, Fly, Heroku...)
# so rate limiting sees each visitor's real IP address.
TRUST_PROXY=1

# Optional
# PORT=3000
# SITE_NAME=Inkwell
# DB_FILE=/var/data/blog.db       # point at a persistent disk/volume
# PAGE_SIZE=6
# SESSION_HOURS=8
# LOGIN_MAX_ATTEMPTS=10           # per IP per 15 minutes
# RATE_LIMIT_PER_MINUTE=300       # per IP
# COOKIE_SECURE=1                 # defaults to 1 when NODE_ENV=production
